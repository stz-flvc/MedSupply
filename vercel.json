{
  "version": 2,
  "buildCommand": "pnpm -r build",
  "outputDirectory": "artifacts/medi-supply/dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "artifacts/api-server/**, lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
