{
  "version": 2,
  "buildCommand": "pnpm -r build",
  "outputDirectory": "artifacts/medi-supply/dist/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "artifacts/api-server/dist/**|lib/db/drizzle/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
